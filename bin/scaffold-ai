#!/usr/bin/env bash
# scaffold-ai: drop the AI-coding-agent project template into a target directory.
#
# Usage:
#   scaffold-ai <target-dir> [--name <project-name>]
#
# Copies template/project/* into <target-dir>, replacing {{PROJECT}} with the
# project name (default: basename of target-dir). Refuses to overwrite existing
# files unless --force is passed.

set -euo pipefail

usage() {
  cat <<EOF
Usage: scaffold-ai <target-dir> [--name <project-name>] [--force]

  Copies the AI agent project template into <target-dir>, expanding the
  {{PROJECT}} placeholder. Existing files are preserved unless --force.
EOF
}

if [ $# -lt 1 ]; then usage; exit 1; fi

TARGET=""
NAME=""
FORCE=0

while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="${2:-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [ -z "$TARGET" ]; then TARGET="$1"; shift
      else echo "Unknown arg: $1" >&2; usage; exit 1
      fi
      ;;
  esac
done

if [ -z "$TARGET" ]; then usage; exit 1; fi
[ -z "$NAME" ] && NAME="$(basename "$TARGET")"

# Locate template via this script's location (works through symlink in ~/.local/bin).
SCRIPT_REAL="$(readlink -f "$0" 2>/dev/null || python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$0")"
DOTFILES_DIR="$(cd "$(dirname "$SCRIPT_REAL")/.." && pwd)"
TEMPLATE_DIR="${DOTFILES_DIR}/template/project"

if [ ! -d "$TEMPLATE_DIR" ]; then
  echo "Template not found at $TEMPLATE_DIR" >&2
  exit 1
fi

mkdir -p "$TARGET"

# Copy with placeholder expansion.
while IFS= read -r -d '' src; do
  rel="${src#$TEMPLATE_DIR/}"
  dst="$TARGET/$rel"
  mkdir -p "$(dirname "$dst")"
  if [ -f "$dst" ] && [ "$FORCE" -ne 1 ]; then
    echo "skip (exists): $rel"
    continue
  fi
  if [ "$(basename "$src")" = ".gitkeep" ]; then
    : > "$dst"
    continue
  fi
  sed "s/{{PROJECT}}/${NAME}/g" "$src" > "$dst"
  echo "wrote:        $rel"
done < <(find "$TEMPLATE_DIR" -type f -print0)

echo
echo "Scaffolded $NAME into $TARGET"
